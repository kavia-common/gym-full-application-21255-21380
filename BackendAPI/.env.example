# BackendAPI environment example
# Copy to .env and adjust values for your environment.

# Core App
APP_NAME="Gym Full Application Backend API"
APP_VERSION="0.1.0"
APP_ENV="development"

# CORS: Comma-separated list of allowed origins for the web app
# Default allows http://localhost:3000
CORS_ALLOW_ORIGINS="http://localhost:3000"

# Database
# IMPORTANT: Point to your Database container/service. Example DSNs:
# - Postgres (psycopg3/binary driver):
#   postgresql+psycopg://user:pass@localhost:5000/gymdb
# Replace host, port, db, user and password to match your Database container.
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5000/gymdb"

# Auth/JWT
# REQUIRED: Secret key for signing JWTs
SECRET_KEY="replace-with-a-strong-random-secret"
# Optional JWT tuning
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="7"
JWT_ISSUER="gym-backend"
JWT_AUDIENCE="gym-web"

# Payments (optional; stubs gracefully no-op if not set)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Notifications - Email via SMTP (optional; graceful no-op if not set)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Notifications - SMS via Twilio (optional; graceful no-op if not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
