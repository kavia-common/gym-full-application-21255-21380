# Required
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/gymdb

# Optional
CORS_ALLOW_ORIGINS=http://localhost:3000

# Auth/JWT
SECRET_KEY=please_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=gym-backend
JWT_AUDIENCE=gym-web

# Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications - Email via SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Notifications - SMS via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+12345550123
