# BackendAPI environment example
APP_NAME="Gym Full Application Backend API"
APP_VERSION="0.1.0"
APP_ENV="development"

# Comma-separated origins, keep localhost:3000 for local React app
CORS_ALLOW_ORIGINS="http://localhost:3000"

# SQLAlchemy DSN for Postgres
# Example: postgresql+psycopg://user:pass@localhost:5000/gymdb
DATABASE_URL="postgresql+psycopg://<user>:<password>@localhost:5000/<database>"
