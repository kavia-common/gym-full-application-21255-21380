# Application
APP_NAME="Gym Full Application Backend API"
APP_VERSION="0.1.0"
APP_ENV="development"

# Database
# Example DSN:
# postgresql+psycopg://user:password@localhost:5432/gymdb
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/gymdb"

# CORS
CORS_ALLOW_ORIGINS="http://localhost:3000"

# Auth / JWT
SECRET_KEY="change-this-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="gym-backend"
JWT_AUDIENCE="gym-web"
