# Application
APP_NAME=Gym Full Application Backend API
APP_VERSION=0.1.0
APP_ENV=development

# Database
# Example DSN: postgresql+psycopg://user:pass@localhost:5432/gymdb
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gymdb

# Auth / JWT
# Strong random string; do not commit real values
SECRET_KEY=change_me_to_a_long_random_string
# Access token TTL (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token TTL (in days)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional issuer/audience (defaults shown)
JWT_ISSUER=gym-backend
JWT_AUDIENCE=gym-web

# CORS
# Comma-separated origins; include frontend dev server by default
# e.g., http://localhost:3000,https://yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:3000
# Alternative key if needed by deployment tooling (kept here for clarity)
CORS_ORIGINS=http://localhost:3000

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
