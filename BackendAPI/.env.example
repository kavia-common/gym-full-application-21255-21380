# BackendAPI environment example
# Copy to .env and adjust values for your environment.

# Core
APP_NAME=Gym Full Application Backend API
APP_VERSION=0.1.0
APP_ENV=development

# Database (required)
# Example for local Postgres running on default port with database 'gymapp'
# Note: user, password, host, and db are placeholders.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gymapp

# CORS (Frontend origin)
# Ensure your React app origin is allowed. Default is http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Auth/JWT (required)
# Use a strong random string in production.
SECRET_KEY=please-change-me-to-a-strong-secret
# Optional expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional issuer/audience
JWT_ISSUER=gym-backend
JWT_AUDIENCE=gym-web

# Payments (optional; stub works without these)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Notifications (optional; API will no-op if not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=Gym App <no-reply@example.com>

# SMS (Twilio; optional)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+12345550123
