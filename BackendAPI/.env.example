# BackendAPI environment example for local development

# Required
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gymdb
SECRET_KEY=replace-with-a-secure-random-string

# Optional: App meta
APP_NAME=Gym Full Application Backend API
APP_VERSION=0.1.0
APP_ENV=development

# CORS (comma-separated). Default already allows http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: Payments (stub works without these)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: Notifications (stub works without these)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=username
# SMTP_PASS=password
# SMTP_FROM=no-reply@example.com

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+12345550123
